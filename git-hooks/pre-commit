#!/bin/sh
# 環境依存の絶対パス（ホームディレクトリ配下、外部ボリューム配下）が
# commit の追加行へ混入するのを防ぐグローバル pre-commit hook。
#
# 適用: git config --global core.hooksPath <このディレクトリ>
# リポジトリ単位で意図的に許可する場合:
#   git config --local hooks.allowLocalPaths true
# このhookが拒否したcommitを --no-verify で通さないこと（共通AGENTS.md §5）。

set -u

# agent-settings（AGENTS.md §1）の3層からキーを解決する。
# <repo>/agent-settings.local.env → <repo>/agent-settings.env → kit既定 の順で
# 最初に見つかった値を返し、どこにも無ければ第2引数の既定を返す。
# 値の書式は KEY=value（引用符なし・1行）。空値も「設定あり」として尊重する。
setting() {
  _key="$1"; _default="$2"
  _top="$(git rev-parse --show-toplevel 2>/dev/null)"
  _kit="$(cd "$(dirname "$0")/.." && pwd -P)"
  for _f in "$_top/agent-settings.local.env" "$_top/agent-settings.env" "$_kit/agent-settings.env"; do
    [ -f "$_f" ] || continue
    if grep -q "^${_key}=" "$_f" 2>/dev/null; then
      sed -n "s/^${_key}=//p" "$_f" | tail -n 1
      return 0
    fi
  done
  printf '%s\n' "$_default"
}

# 一時ディレクトリ配下の使い捨てリポジトリ（他プロジェクトのテストが mktemp に作る
# fixture など）では、このhookが動く理由が機械全体の core.hooksPath だけなら、kitの検査
# （guard・textlint・gitleaks のすべて）を行わず、repo固有の .git/hooks へ委譲するだけにする。
# global の core.hooksPath がある間は git が .git/hooks を直接呼ばないため、その委譲を
# 残さないと repo 自身の hook まで消える。
# 3条件がすべて成り立つときだけ該当: toplevel が一時ディレクトリ配下 / local config に
# core.hooksPath が無い / global か system の config に core.hooksPath がある。
# kit自身のテストは local に hooksPath を置くか、global を隔離してhookを直接実行するので
# この条件には当たらない。一時ディレクトリで意図的にguardを効かせたいリポジトリは
# git config --local core.hooksPath を設定する。toplevel が取れなければ該当しない（fail-closed）。
# $TMPDIR は継承される環境変数なので、/ や $HOME の祖先を指す誤設定は一時ディレクトリと見ない。
is_throwaway_repo() {
  _top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
  [ -n "$_top" ] || return 1
  _top="$(cd "$_top" 2>/dev/null && pwd -P)" || return 1
  git config --local --get-all core.hooksPath >/dev/null 2>&1 && return 1
  { git config --global --get-all core.hooksPath >/dev/null 2>&1 \
    || git config --system --get-all core.hooksPath >/dev/null 2>&1; } || return 1
  _tmp=""
  if [ -n "${TMPDIR:-}" ] && _tmp_real="$(cd "$TMPDIR" 2>/dev/null && pwd -P)"; then
    case "$_tmp_real" in
      /) ;;
      *) case "${HOME:-}" in "$_tmp_real"|"$_tmp_real"/*) ;; *) _tmp="$_tmp_real" ;; esac ;;
    esac
  fi
  for _d in "$_tmp" /tmp /var/tmp /private/var/folders; do
    [ -n "$_d" ] && [ -d "$_d" ] || continue
    _real="$(cd "$_d" 2>/dev/null && pwd -P)" || continue
    case "$_top" in "$_real"|"$_real"/*) return 0 ;; esac
  done
  return 1
}

# リポジトリ固有の .git/hooks/pre-commit があれば最後に委譲する。
# --git-path は core.hooksPath を尊重してこのhook自身を返すため使わない（自己再帰防止）。
run_local_hook() {
  git_dir="$(git rev-parse --git-dir 2>/dev/null)"
  local_hook="$git_dir/hooks/pre-commit"
  self="$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")"
  if [ -n "$git_dir" ] && [ -x "$local_hook" ]; then
    local_real="$(cd "$(dirname "$local_hook")" 2>/dev/null && pwd -P)/pre-commit"
    if [ "$local_real" != "$self" ]; then
      exec "$local_hook" "$@"
    fi
  fi
  exit 0
}

# 使い捨てリポジトリなら kit の検査を飛ばし、repo固有の hook への委譲だけ行う。
is_throwaway_repo && run_local_hook "$@"

# 日本語文書lint（textlint）。全リポジトリで既定有効。リポジトリ直下に設定が
# あればそれを優先し、なければこのkit同梱の規則で検査する。opt-outは
# git config --local hooks.skipTextlint true。textlint未導入の環境では警告だけ
# 出して通す（pre-pushのgitleaksと同じfail-open。検査対象はworking treeの
# 内容で、部分stage時はstage内容と差が出得る）。
#
# 指摘があった場合、自動修正できる分はworking treeへ適用するが、stageも
# commit続行もしない。機械の修正が過剰なことがあるため、人間が差分を確認して
# stageし直す手順を必ず挟む（機械が直し、人が承認する）。
run_textlint() {
  staged_md="$(git diff --cached --name-only --diff-filter=d -- '*.md')"
  [ -n "$staged_md" ] || return 0
  if [ "$(setting TEXTLINT true)" = "false" ]; then
    return 0
  fi
  if [ "$(git config --type=bool --default=false hooks.skipTextlint)" = "true" ]; then
    return 0
  fi
  cfg=""
  for name in .textlintrc .textlintrc.json .textlintrc.yml .textlintrc.yaml; do
    if [ -f "$name" ]; then cfg="$name"; break; fi
  done
  if [ -z "$cfg" ]; then
    kit_root="$(cd "$(dirname "$0")/.." && pwd -P)"
    cfg="$kit_root/.textlintrc.json"
    [ -f "$cfg" ] || return 0
  fi
  if ! command -v textlint >/dev/null 2>&1; then
    echo "pre-commit: textlint未導入のため日本語lintを省略します（agent-kit READMEのGit hooks節を参照）。" >&2
    return 0
  fi
  # 日本語lintなので、日本語の文書だけを対象にする。日本語の文字が英数字＋日本語文字の2%未満
  # （英語READMEの相互リンク1行など）なら英語文書とみなして飛ばす。perlが無い環境では
  # 従来どおり全ファイルを検査する。scripts/textlint-hook.py と同じ判定。
  if command -v perl >/dev/null 2>&1; then
    staged_md="$(printf '%s\n' "$staged_md" | while IFS= read -r f; do
      [ -n "$f" ] || continue
      if perl -CSD -ne '$j += () = /[\x{3005}\x{3040}-\x{309f}\x{30a0}-\x{30ff}\x{3400}-\x{4dbf}\x{4e00}-\x{9fff}\x{ff66}-\x{ff9f}]/g; $l += () = /[A-Za-z]/g; END { exit(($j > 0 && $j / ($j + $l) >= 0.02) ? 0 : 1) }' "$f" 2>/dev/null; then
        printf '%s\n' "$f"
      fi
    done)"
    [ -n "$staged_md" ] || return 0
  fi
  if printf '%s\n' "$staged_md" | tr '\n' '\0' | xargs -0 textlint --no-color --config "$cfg" >/dev/null 2>&1; then
    return 0
  fi

  # 未stageの変更が既にあるファイルは、無関係な変更との混在を避けるため
  # 自動修正の対象にしない。
  fix_targets=""
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if git diff --quiet -- "$f" 2>/dev/null; then
      fix_targets="${fix_targets}${f}
"
    fi
  done <<TARGETS
$staged_md
TARGETS
  fixed=""
  if [ -n "$fix_targets" ]; then
    printf '%s' "$fix_targets" | tr '\n' '\0' | xargs -0 textlint --no-color --fix --config "$cfg" >/dev/null 2>&1 || true
    fixed="$(printf '%s' "$fix_targets" | tr '\n' '\0' | xargs -0 git diff --name-only -- 2>/dev/null)"
  fi
  remaining="$(printf '%s\n' "$staged_md" | tr '\n' '\0' | xargs -0 textlint --no-color --config "$cfg" 2>&1)" && remaining=""

  {
    if [ -n "$fixed" ] && [ -z "$remaining" ]; then
      echo "pre-commit: textlintの指摘を自動修正しました。差分を確認してstageし、再commitしてください。"
    elif [ -n "$fixed" ]; then
      echo "pre-commit: textlintの指摘の一部を自動修正しました。差分の確認と、残りの指摘の修正が必要です。"
    else
      echo "pre-commit: textlintの指摘があります。修正してから再commitしてください。"
    fi
    if [ -n "$fixed" ]; then
      echo "自動修正を適用したファイル（未stage。内容を確認してからstageしてください）:"
      printf '%s\n' "$fixed" | sed 's/^/  - /'
    fi
    if [ -n "$remaining" ]; then
      echo "残りの指摘:"
      printf '%s\n' "$remaining"
    fi
    echo "  - --no-verify での回避は禁止（共通AGENTS.md §5）"
    echo "  - 規則の調整は、共有kit側の設定ではなく、このリポジトリ直下の"
    echo "    .textlintrc.json（無ければkit設定を複製して作成）で行う"
    echo "  - 意図的に検査しないリポジトリでは: git config --local hooks.skipTextlint true"
  } >&2
  exit 1
}

# stagedの.mdについて、相対リンクの参照先が存在するかを検査する。決定論的で
# LLMを呼ばない（数ms）。scheme付きURL・アンカーのみ・絶対パスは対象外。
# コードフェンス内のリンク例は検査しない。opt-outは
# git config --local hooks.skipLinkCheck true。perlが無い環境では省略する（fail-open）。
# 検査対象はworking treeの内容で、部分stage時はstage内容と差が出得る（textlintと同じ）。
run_linkcheck() {
  if [ "$(setting LINKCHECK true)" = "false" ]; then
    return 0
  fi
  if [ "$(git config --type=bool --default=false hooks.skipLinkCheck)" = "true" ]; then
    return 0
  fi
  command -v perl >/dev/null 2>&1 || return 0
  staged_md="$(git diff --cached --name-only --diff-filter=d -- '*.md')"
  [ -n "$staged_md" ] || return 0
  broken="$(printf '%s\n' "$staged_md" | perl -CSD -e '
    use File::Basename;
    while (my $f = <STDIN>) {
      chomp $f; next unless -f $f;
      open my $fh, "<:encoding(UTF-8)", $f or next;
      my $fence = 0; my $ln = 0;
      while (my $line = <$fh>) {
        $ln++;
        if ($line =~ /^\s*(```|~~~)/) { $fence = !$fence; next; }
        next if $fence;
        while ($line =~ /\]\(([^)\s]+)\)/g) {
          my $t = $1;
          next if $t =~ m{^[a-z][a-z0-9+.-]*:};
          next if $t =~ m{^[#/]};
          $t =~ s/#.*$//;
          next if $t eq "";
          my $p = dirname($f) . "/" . $t;
          print "  $f:$ln -> $t\n" unless -e $p;
        }
      }
    }
  ')"
  [ -z "$broken" ] && return 0
  {
    echo "pre-commit: Markdownの相対リンクに参照先が存在しないものがあります。"
    echo "$broken"
    echo "対応:"
    echo "  - リンク先のパスを修正するか、ファイルを追加する"
    echo "  - このリポジトリで意図的に検査しない場合: git config --local hooks.skipLinkCheck true"
    echo "  - --no-verify での回避は禁止（共通AGENTS.md §5）"
  } >&2
  exit 1
}

# detached HEADへのcommitを止める。branchを確認せずにcommitして無関係な
# 履歴系列へ載せる事故を防ぐ（共通AGENTS.md §8「commit前にbranch確認」の機械化）。
# rebase・am進行中はgitが正規にdetachedで動くため検査しない。
run_branch_guard() {
  if [ "$(git config --type=bool --default=false hooks.allowDetachedHead)" = "true" ]; then
    return 0
  fi
  git_dir="$(git rev-parse --git-dir 2>/dev/null)"
  for marker in rebase-merge rebase-apply; do
    [ -e "$git_dir/$marker" ] && return 0
  done
  if git symbolic-ref -q HEAD >/dev/null 2>&1; then
    return 0
  fi
  {
    echo "pre-commit: detached HEADのためcommitを中止しました。"
    echo "  - git branch --show-current と git log --oneline -3 で現在地を確認する"
    echo "  - 意図したbranchへ checkout / switch してから再commitする"
    echo "  - このリポジトリで意図的に許可する場合: git config --local hooks.allowDetachedHead true"
    echo "  - --no-verify での回避は禁止（共通AGENTS.md §5）"
  } >&2
  exit 1
}

# main（master）のcheckoutでの挙動変更commitを止める。stagedがすべて.mdの
# 文書のみcommitは通す（共通AGENTS.md §8「挙動変更はtask branch＋worktreeで、
# 軽微な文書更新のみmain可」の機械化）。mergeの仕上げcommit（MERGE_HEADあり）は
# 明示許可済みのmerge操作なので対象外。main直接commitが慣行のリポジトリは
# git config --local hooks.allowMainCommits true でopt-outする。
run_main_guard() {
  if [ "$(setting MAIN_DOC_GUARD true)" = "false" ]; then
    return 0
  fi
  if [ "$(git config --type=bool --default=false hooks.allowMainCommits)" = "true" ]; then
    return 0
  fi
  branch="$(git symbolic-ref --short -q HEAD)" || return 0
  case "$branch" in main|master) ;; *) return 0 ;; esac
  git_dir="$(git rev-parse --git-dir 2>/dev/null)"
  [ -e "$git_dir/MERGE_HEAD" ] && return 0
  # 文書扱い = .md に加えて MAIN_GUARD_EXTRA_DOCS のglob（空白区切り。既定はdotfile類）。
  extra_docs="$(setting MAIN_GUARD_EXTRA_DOCS '.*')"
  nondoc="$(git diff --cached --name-only | while IFS= read -r f; do
    case "$f" in (*.md) continue ;; esac
    matched=false
    for p in $extra_docs; do
      case "$f" in ($p) matched=true; break ;; esac
    done
    [ "$matched" = "true" ] || printf '%s\n' "$f"
  done)"
  [ -z "$nondoc" ] && return 0
  {
    echo "pre-commit: ${branch} 上での文書以外の変更commitを中止しました。"
    echo "対象:"
    printf '%s\n' "$nondoc" | sed 's/^/  - /'
    echo "対応:"
    echo "  - task専用branchとworktreeを作ってからcommitする（共通AGENTS.md §8）"
    echo "  - main直接commitが慣行のリポジトリでは: git config --local hooks.allowMainCommits true"
    echo "  - 文書扱いのパターン追加・ガード無効化は agent-settings.env（AGENTS.md §1）"
    echo "  - --no-verify での回避は禁止（共通AGENTS.md §5）"
  } >&2
  exit 1
}

# 秘密情報の走査（gitleaks）。stageされた内容を対象にcommit前へ蓋をする。
# pre-pushの全履歴走査より早い段階で止めるための層。gitleaksは導入必須とし、
# 未導入の環境ではcommitを停止する（黙って素通りさせない）。誤検知は
# .gitleaksignore へfingerprintを追加して抑止する。
run_gitleaks() {
  if ! command -v gitleaks >/dev/null 2>&1; then
    {
      echo "pre-commit: gitleaksが未導入のためcommitを中止しました（導入必須）。"
      echo "  - brew install gitleaks で導入してから再commitする"
      echo "  - --no-verify での回避は禁止（共通AGENTS.md §5）"
    } >&2
    exit 1
  fi
  if ! gitleaks git --pre-commit --staged --no-banner --redact . >&2; then
    {
      echo "pre-commit: gitleaksが秘密情報らしき値を検出したためcommitを中止しました。"
      echo "  - 該当値を除去する。誤検知の場合は .gitleaksignore へfingerprintを追加する"
      echo "  - --no-verify での回避は禁止（共通AGENTS.md §5）"
    } >&2
    exit 1
  fi
}

# まとめ忘れガード。stageされた変更が未push範囲（@{upstream}..HEAD）のcommitを
# 打ち消すなら、取り消しcommitを重ねず履歴をまとめ直すよう促して中止する
# （「未pushの同目的の手直しはpush前にまとめる」運用の機械化）。
# 取り消しの2commitが残ると、push時にgitleaksをすり抜けた秘密情報が履歴に残る経路にもなる。
# 値: agent-settings の SQUASH_GUARD。true=中止、warn=警告して続行、false=無効。
# 既定は warn（新しいhookなので、まず誤検知が無いことを確かめてから true にする）。
# 試行の記録として意図的に残すrepo: git config --local hooks.allowNetZeroHistory true
run_squash_guard() {
  # true以外の未知の値は中止側に倒す（設定の書き間違いでガードが消えないように）。
  mode="$(setting SQUASH_GUARD warn)"
  [ "$mode" = "false" ] && return 0
  if [ "$(git config --local --type=bool --default=false hooks.allowNetZeroHistory)" = "true" ]; then
    return 0
  fi
  # merge・cherry-pick・revertの仕上げcommitは、打ち消しに見えても明示的に開始した
  # 正規の操作なので対象外（run_main_guardのMERGE_HEAD扱いと同じ）。
  git_dir="$(git rev-parse --git-dir 2>/dev/null)"
  for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
    [ -e "$git_dir/$marker" ] && return 0
  done
  # upstream未設定（初回push前のbranch等）は未push範囲を定義できないためスキップする。
  # 既知の限界: 比較基準はupstream tipのため、upstreamが先行して分岐している間は
  # 「upstream側と同じ内容へ揃えるstage」を巻き戻しと誤検知し得る（opt-outで回避）。
  # また `git commit --amend` はHEADを置き換えるので相殺は履歴に残らないが、
  # hookからは新規commitと区別できないため同様に止まる（reset --soft で回避する）。
  # renameは --no-renames で追加と削除に分けて見るため、未push範囲で追加した
  # ファイルの `git mv` は削除側が打ち消しに見えて止まる（まとめ直すかopt-out）。
  upstream="$(git rev-parse --verify --quiet '@{upstream}' 2>/dev/null)" || return 0
  [ -n "$upstream" ] || return 0
  [ "$(git rev-list --count "$upstream"..HEAD 2>/dev/null || echo 0)" -gt 0 ] || return 0

  bad=""
  oldIFS=$IFS
  IFS='
'
  set -f
  # パターン1: stageで削除されるファイルが、未push範囲で追加されたもの
  # （upstreamに存在しない＝追加も削除も未pushで、まとめれば履歴から消える）
  for f in $(git -c core.quotePath=false diff --cached --name-only --no-renames --diff-filter=D); do
    if ! git cat-file -e "$upstream:$f" 2>/dev/null; then
      added_in="$(git -c core.quotePath=false log --format=%h --no-renames --diff-filter=A "$upstream"..HEAD -- "$f" | tr '\n' ' ')"
      if [ -n "$added_in" ]; then
        bad="$bad  削除: ${f}（未push commit ${added_in}で追加）
"
      fi
    fi
  done
  # パターン2: stage後の内容がupstream時点と同一に戻るファイル（未push範囲で触っている場合）。
  # 「未push commitで削除→同一内容で復元」はHEAD比でAになるため、AMの両方を見る。
  for f in $(git -c core.quotePath=false diff --cached --name-only --no-renames --diff-filter=AM); do
    if git cat-file -e "$upstream:$f" 2>/dev/null; then
      if git diff --quiet --cached "$upstream" -- "$f" 2>/dev/null; then
        touched_in="$(git -c core.quotePath=false log --format=%h --no-renames "$upstream"..HEAD -- "$f" | tr '\n' ' ')"
        if [ -n "$touched_in" ]; then
          bad="$bad  巻き戻し: ${f}（未push commit ${touched_in}の変更を打ち消し）
"
        fi
      fi
    fi
  done
  set +f
  IFS=$oldIFS
  [ -n "$bad" ] || return 0
  {
    if [ "$mode" = "warn" ]; then
      echo "pre-commit: 未pushのcommitを打ち消す変更を検出しました。"
    else
      echo "pre-commit: 未pushのcommitを打ち消す変更のため、commitを中止しました。"
    fi
    printf '%s' "$bad"
    if [ "$mode" = "warn" ]; then
      echo "（SQUASH_GUARD=warn のため続行します。まとめ直しは git reset --soft）"
    else
      echo "対応:"
      echo "  - 該当commitまで git reset --soft で戻り、取り消し後の姿でcommitし直す（共通AGENTS.md §8）"
      echo "  - 試行の記録として意図的に履歴へ残す場合: git config --local hooks.allowNetZeroHistory true"
      echo "  - ガード全体のOFFは agent-settings.env の SQUASH_GUARD=false（AGENTS.md §1）"
      echo "  - --no-verify での回避は禁止（共通AGENTS.md §5）"
    fi
  } >&2
  [ "$mode" = "warn" ] && return 0
  exit 1
}

run_branch_guard
run_main_guard
run_squash_guard
run_gitleaks
run_textlint
run_linkcheck

if [ "$(git config --type=bool --default=false hooks.allowLocalPaths)" = "true" ]; then
  run_local_hook "$@"
fi

# 検出パターン: $HOME（symlink解決版も含む）と外部ボリューム配下。
# パターン文字列は、このhook自身が検査（validate-kit・pre-commit）に
# 検出されないよう分割して書く。
home_real="$(cd "$HOME" 2>/dev/null && pwd -P || printf '%s' "$HOME")"
pattern="$HOME|$home_real|/Vol""umes/"

hits="$(git diff --cached --diff-filter=d -U0 --no-color \
  | awk -v pat="$pattern" '
      /^\+\+\+ b\// { file = substr($0, 7); next }
      /^\+\+\+/ { next }
      /^\+/ && $0 ~ pat { printf "  %s: %s\n", file, substr($0, 2) }
    ')"

if [ -n "$hits" ]; then
  {
    echo "pre-commit: 環境依存の絶対パスが追加行に含まれています。"
    echo "$hits"
    echo ""
    echo "対応:"
    echo "  - 相対パス、プレースホルダー、実行時解決（\$HOME 等）へ置き換える"
    echo "  - このリポジトリで意図的に許可する場合:"
    echo "      git config --local hooks.allowLocalPaths true"
    echo "  - --no-verify での回避は禁止（共通AGENTS.md §5）"
  } >&2
  exit 1
fi

run_local_hook "$@"
