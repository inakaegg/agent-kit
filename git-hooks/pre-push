#!/bin/sh
# push対象のcommit範囲をgitleaksで走査し、秘密情報らしき値を検出したら
# pushを拒否するグローバル pre-push hook。
#
# 適用: git config --global core.hooksPath <このディレクトリ>
# 初回push（remote側にbranchが無い場合）は到達可能な全履歴を走査する。
# gitleaks未導入の環境では、導入方法を警告してpushは通す（fail-open）。
# このhookが拒否したpushを --no-verify で通さないこと（共通AGENTS.md §5）。

set -u

zero=0000000000000000000000000000000000000000
input="$(cat)"

# agent-settings（AGENTS.md §1）の3層からキーを解決する（pre-commitと同じ規約）。
setting() {
  _key="$1"; _default="$2"
  _top="$(git rev-parse --show-toplevel 2>/dev/null)"
  _kit="$(cd "$(dirname "$0")/.." && pwd -P)"
  for _f in "$_top/agent-settings.local.env" "$_top/agent-settings.env" "$_kit/agent-settings.env"; do
    [ -f "$_f" ] || continue
    if grep -q "^${_key}=" "$_f" 2>/dev/null; then
      sed -n "s/^${_key}=//p" "$_f" | tail -n 1
      return 0
    fi
  done
  printf '%s\n' "$_default"
}

# 一時ディレクトリ配下の使い捨てリポジトリでは、このhookが動く理由が機械全体の
# core.hooksPath だけなら kit の検査を飛ばし、repo固有の hook への委譲だけ行う
# （条件と理由は pre-commit の同名関数と同じ）。
is_throwaway_repo() {
  _top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
  [ -n "$_top" ] || return 1
  _top="$(cd "$_top" 2>/dev/null && pwd -P)" || return 1
  git config --local --get-all core.hooksPath >/dev/null 2>&1 && return 1
  { git config --global --get-all core.hooksPath >/dev/null 2>&1 \
    || git config --system --get-all core.hooksPath >/dev/null 2>&1; } || return 1
  _tmp=""
  if [ -n "${TMPDIR:-}" ] && _tmp_real="$(cd "$TMPDIR" 2>/dev/null && pwd -P)"; then
    case "$_tmp_real" in
      /) ;;
      *) case "${HOME:-}" in "$_tmp_real"|"$_tmp_real"/*) ;; *) _tmp="$_tmp_real" ;; esac ;;
    esac
  fi
  for _d in "$_tmp" /tmp /var/tmp /private/var/folders; do
    [ -n "$_d" ] && [ -d "$_d" ] || continue
    _real="$(cd "$_d" 2>/dev/null && pwd -P)" || continue
    case "$_top" in "$_real"|"$_real"/*) return 0 ;; esac
  done
  return 1
}

# リポジトリがopt-in（git config --local hooks.runAgentCheck true）している場合だけ、
# scripts/agent-check.sh（検証コマンドの集約。templates/VERIFICATION.md参照）をfastモードで
# 実行し、失敗したらpushを止める。手動の検査は忘れられるため実行を機械に持たせる
# （共通AGENTS.md §5）。既定offなのは、このhookがcore.hooksPathで全リポジトリに効くため、
# cloneした他者のリポジトリに含まれるスクリプトをpushだけで実行させないため。
run_agent_check() {
  [ "$(git config --local --type=bool --default=false hooks.runAgentCheck 2>/dev/null)" = "true" ] || return 0
  [ -x scripts/agent-check.sh ] || return 0
  echo "pre-push: $(pwd)/scripts/agent-check.sh fast を実行します（hooks.runAgentCheck=true）" >&2
  # gitはhookへ GIT_DIR / GIT_WORK_TREE 等の絶対パスを渡す。そのまま検査scriptへ継承させると、
  # 使い捨てrepoを作るテストのgit操作までこのrepoへ向く（branchへの空commit、余分なworktree）。
  # 検査scriptはcwd（このrepoのroot）からgitを解決できるので、起動前にこれらを外す。
  if ! env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_OBJECT_DIRECTORY -u GIT_COMMON_DIR -u GIT_PREFIX -u GIT_ALTERNATE_OBJECT_DIRECTORIES scripts/agent-check.sh fast; then
    {
      echo ""
      echo "pre-push: scripts/agent-check.sh fast が失敗したためpushを中止しました。"
      echo "  - 失敗した検査を修正してから再pushする"
      echo "  - --no-verify での回避は禁止（共通AGENTS.md §5）"
    } >&2
    exit 1
  fi
}

# リポジトリ固有の .git/hooks/pre-push があれば最後に委譲する（その前に検証スクリプトを実行）。
run_local_hook() {
  run_agent_check
  git_dir="$(git rev-parse --git-dir 2>/dev/null)"
  local_hook="$git_dir/hooks/pre-push"
  self="$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")"
  if [ -n "$git_dir" ] && [ -x "$local_hook" ]; then
    local_real="$(cd "$(dirname "$local_hook")" 2>/dev/null && pwd -P)/pre-push"
    if [ "$local_real" != "$self" ]; then
      printf '%s\n' "$input" | "$local_hook" "$@"
      exit $?
    fi
  fi
  exit 0
}

# 使い捨てリポジトリなら kit の検査を飛ばし、repo固有の hook への委譲だけ行う
# （run_local_hook 内の agent-check は local の opt-in が無いので走らない）。
is_throwaway_repo && run_local_hook "$@"

# まとめ忘れガード（最終防衛層。主はpre-commit側）。push範囲を通して見たときだけ
# 分かる相殺——3commit以上の合成でのnet-zero、別セッション由来のcommitとの相殺——を
# 検出してpushを中止する。取り消しの2commitが残ると、gitleaksのルールをすり抜けた
# 秘密情報が履歴に残る経路にもなる。gitleaksの有無に依存しないよう、gitleaks走査より
# 前に実行する。既知の限界: merge commitの差分は範囲走査に出ないため、mergeを含む
# 範囲の相殺は検出しない。範囲内で「追加→削除→同一内容で再追加」まで進んだパスも、
# 範囲の前後で見ると新規追加なので、途中の削除・再追加は検出しない。renameは
# --no-renames で追加と削除に分けて数えるため、範囲内で `git mv` して戻した場合と
# 単に移動した場合を区別できず、移動後のパスが範囲外に無ければ相殺として止まり得る。
# 値: agent-settings の SQUASH_GUARD。true=中止、warn=警告して続行、false=無効。
# 既定は warn。true以外の未知の値は中止側に倒す。
# 意図的に残すrepo: git config --local hooks.allowNetZeroHistory true
#
# $1=内容比較の基準commit（空なら基準なし＝パターン2は見ない）
# $2=送るcommitの先端
# $3以降=範囲を表す git log の引数（既存branchは base..tip、初回pushは
#         tip --not --remotes=<remote>）
run_squash_guard_range() {
  base="$1"; tip="$2"; shift 2
  bad=""
  oldIFS=$IFS
  IFS='
'
  set -f
  # パターン1: 範囲内で追加され、同範囲内で削除されたパス（範囲前後のどちらにも存在しない）
  added="$(git -c core.quotePath=false log --format= --name-only --no-renames --diff-filter=A "$@" | grep -v '^$' | sort -u)"
  deleted="$(git -c core.quotePath=false log --format= --name-only --no-renames --diff-filter=D "$@" | grep -v '^$' | sort -u)"
  for f in $(printf '%s\n%s\n' "$added" "$deleted" | grep -v '^$' | sort | uniq -d); do
    [ -n "$base" ] && git cat-file -e "$base:$f" 2>/dev/null && continue
    git cat-file -e "$tip:$f" 2>/dev/null && continue
    bad="$bad  追加→削除: $f
"
  done
  # パターン2: 範囲内で2commit以上が触ったのに、範囲前後で内容が同一のパス。
  # 基準が定まらない範囲（初回pushで分岐点が複数）では「元どおり」を定義できないので見ない。
  if [ -n "$base" ]; then
    for f in $(git -c core.quotePath=false log --format= --name-only --no-renames "$@" | grep -v '^$' | sort | uniq -d); do
      git cat-file -e "$base:$f" 2>/dev/null || continue
      if git diff --quiet "$base" "$tip" -- "$f" 2>/dev/null; then
        bad="$bad  相殺: ${f}（複数commitで変更したが内容は元どおり）
"
      fi
    done
  fi
  set +f
  IFS=$oldIFS
  [ -z "$bad" ] && return 0
  {
    echo ""
    if [ "$squash_mode" = "warn" ]; then
      echo "pre-push: push範囲内で互いを打ち消すcommitを検出しました。"
    else
      echo "pre-push: push範囲内で互いを打ち消すcommitがあるため、pushを中止しました。"
    fi
    printf '%s' "$bad"
    if [ "$squash_mode" = "warn" ]; then
      echo "（SQUASH_GUARD=warn のため続行します。まとめ直しは git reset --soft / rebase）"
    else
      echo "対応:"
      echo "  - 未push範囲なので、該当commitをまとめ直してから再pushする（reset --soft / rebase）"
      echo "  - 試行の記録として意図的に残す場合: git config --local hooks.allowNetZeroHistory true"
      echo "  - ガード全体のOFFは agent-settings.env の SQUASH_GUARD=false（AGENTS.md §1）"
      echo "  - --no-verify での回避は禁止（共通AGENTS.md §5）"
    fi
  } >&2
  [ "$squash_mode" = "warn" ] && return 0
  exit 1
}

squash_mode="$(setting SQUASH_GUARD warn)"
if [ "$squash_mode" != "false" ] \
  && [ "$(git config --local --type=bool --default=false hooks.allowNetZeroHistory)" != "true" ]; then
  # push先の名前（gitが第1引数で渡す）。URL直指定のときはURLが渡るので、登録済みの
  # remoteのURLと突き合わせて名前へ寄せる。どれとも一致しなければURLのまま扱う。
  remote_name="${1:-origin}"
  if [ -z "$(git for-each-ref --count=1 --format='%(refname)' "refs/remotes/$remote_name" 2>/dev/null)" ]; then
    for r in $(git remote 2>/dev/null); do
      for u in "$(git remote get-url "$r" 2>/dev/null)" "$(git remote get-url --push "$r" 2>/dev/null)"; do
        [ -n "$u" ] || continue
        if [ "$u" = "$remote_name" ]; then remote_name="$r"; break; fi
      done
      [ "$remote_name" = "$r" ] && break
    done
  fi
  remote_refs="$(git for-each-ref --count=1 --format='%(refname)' "refs/remotes/$remote_name" 2>/dev/null)"
  while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${local_ref:-}" ] && continue
    [ "$local_sha" = "$zero" ] && continue          # branch削除
    if [ "$remote_sha" = "$zero" ]; then
      # 初回push。比較基準のremote_shaは無いが、送るcommitは「local_shaから到達でき、
      # remoteのどのrefからも到達できないcommit」として決まる。
      if [ -z "$remote_refs" ]; then
        # 追跡refが1つも無い（空のremoteへの初回push、URLから名前を解決できない等）。
        # 送るのは到達可能な全履歴なので、それを範囲として扱う（gitleaksが初回pushで
        # 全履歴を走査するのと同じ）。範囲の手前が無いためパターン2は判定できず、
        # 「範囲内で追加して削除したパス」だけを見る。
        run_squash_guard_range "" "$local_sha" "$local_sha"
      else
        # 範囲の手前（boundary）が内容比較の基準。分岐点が複数ある範囲では基準を1つに
        # 決められないため、基準なし（パターン1のみ）で走査する。
        boundary="$(git rev-list --boundary "$local_sha" --not "--remotes=$remote_name" 2>/dev/null | sed -n 's/^-//p')"
        base=""
        [ "$(printf '%s\n' "$boundary" | grep -c .)" -eq 1 ] && base="$boundary"
        run_squash_guard_range "$base" "$local_sha" "$local_sha" --not "--remotes=$remote_name"
      fi
    elif ! git cat-file -e "$remote_sha" 2>/dev/null; then
      # 履歴の書き換え後などでリモートの現在地がローカルに無い。基準が無いまま通すと
      # ガードがそこだけ効かなくなるため、fetchを促して中止する（fail-closed）。
      {
        echo ""
        echo "pre-push: リモートの現在地 ${remote_sha} がローカルに無く、打ち消しの検査ができません。"
        echo "対応:"
        echo "  - git fetch ${remote_name} を実行してから再pushする"
        echo "  - ガード全体のOFFは agent-settings.env の SQUASH_GUARD=false（AGENTS.md §1）"
        echo "  - --no-verify での回避は禁止（共通AGENTS.md §5）"
      } >&2
      exit 1
    else
      run_squash_guard_range "$remote_sha" "$local_sha" "$remote_sha..$local_sha"
    fi
  done <<EOF
$input
EOF
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks未導入のため秘密情報の走査をスキップしました（brew install gitleaks で導入）" >&2
  run_local_hook "$@"
fi

status=0
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue
  [ "$local_sha" = "$zero" ] && continue # branch削除は走査対象なし
  if [ "$remote_sha" = "$zero" ]; then
    log_opts="$local_sha" # 初回push: 到達可能な全履歴
  elif ! git cat-file -e "$remote_sha" 2>/dev/null; then
    # 履歴書き換え(filter-repo等)の後はリモートの現在地がローカルに存在せず、
    # 範囲指定が解決できない。gitleaksはそのgitエラーでもexit 0を返すため、
    # 範囲走査のままでは1commitも見ずに素通しになる。全履歴走査へ切り替える。
    echo "pre-push: リモートの現在地がローカルで解決できないため、全履歴を走査します。" >&2
    log_opts="$local_sha"
  else
    log_opts="$remote_sha..$local_sha" # 既存branch: 送信するcommitだけ
  fi
  if ! gitleaks git --no-banner --redact --log-opts "$log_opts" .; then
    status=1
  fi
done <<EOF
$input
EOF

if [ "$status" -ne 0 ]; then
  {
    echo ""
    echo "pre-push: gitleaksが秘密情報らしき値を検出したためpushを中止しました。"
    echo "  - 該当commitから値を除去する（履歴に入った場合は履歴の書き換えも検討）"
    echo "  - 誤検知の場合は .gitleaksignore へfingerprintを追加する"
    echo "  - --no-verify での回避は禁止（共通AGENTS.md §5）"
  } >&2
  exit 1
fi

run_local_hook "$@"
