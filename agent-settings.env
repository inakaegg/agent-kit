# agent-kit 設定トグル（AGENTS.md §1）。
# 解決順: このkit既定 → <作業repo>/agent-settings.env → <作業repo>/agent-settings.local.env
# （後の層が優先。local.env はgit管理外にする）。値は原則 true / false だが、
# キーによっては固有の値を取る（各キーのコメントを参照）。
# キーの追加は AGENTS.md §1 の手続き（ユーザー確認）に従い、該当規則の箇所へキー名を併記する。

# 実装依頼でエージェントがローカルcommitまで行う（AGENTS.md §3）
AUTO_COMMIT=true

# 他者と共有しない非公開repositoryで、必要なレビューをすべて通したtask branchを
# default branchへローカルmergeするのに、そのターンの明示許可を要らなくする（AGENTS.md §3）。
# push・PR作成・公開repositoryのmergeには効かない。mergeは常に --no-ff
AUTO_MERGE_PRIVATE=true

# merge済みのlinked worktreeを、許可を得ずに削除してよい（AGENTS.md §8）。
# branchは消さない（graphでつながりを見るため）。未commit差分・ignoredな
# ローカルファイル（.env・生成物など）が残るworktreeは対象外
AUTO_PRUNE_WORKTREES=true

# main/master への文書以外commitをpre-commitで拒否する
MAIN_DOC_GUARD=true

# mainガードで .md 以外に「文書扱い」とするglob（空白区切り）。既定はdotfile類
MAIN_GUARD_EXTRA_DOCS=.*

# 未pushのcommitを打ち消すcommit・pushを止める（まとめ忘れガード。AGENTS.md §8の
# 「同目的の手直しはまとめる」の機械化。pre-commitが主、pre-pushが最終防衛）。
# true=検出したら中止 / warn=検出内容を警告して続行 / false=無効。
# 新しいhookのため既定は warn とし、誤検知が出ないことを確かめたrepoが、そのrepoの
# agent-settings.env で SQUASH_GUARD=true にして中止まで有効にする。
# repo単位の恒久opt-outは git config --local hooks.allowNetZeroHistory true
SQUASH_GUARD=warn

# 日本語文書lint（pre-commit textlint）
TEXTLINT=true

# Markdown相対リンクの存在検査（pre-commit）
LINKCHECK=true

# 挙動変更はtask branch + 別worktreeで行う（AGENTS.md §8）。falseなら別branchのみでよい
REQUIRE_WORKTREE=true

# 通常対象作業にも実装レビューを課す（AGENTS.md §7）。falseでも重リスク作業の3段階レビューは免除しない
INDEPENDENT_REVIEW=true

# 人間向け文書の読みやすさレビュー（AGENTS.md §7）
READABILITY_REVIEW=true

# CLI先行実装（AGENTS.md §5）
CLI_FIRST=true

# commitメッセージの言語順。件名と本文の両方に効く
# （AGENTS.md §8 / docs/policies/git-and-remote.md）。
# 件名: en-ja=「英語 / 日本語」、ja-en=「日本語 / 英語」、off=検査しない。
# 本文: 件名が日本語規約で本文があるcommitに、英語・日本語の併記を同じ順で要求する。
# 規約上もともとrepository規則が優先なので、日本語先を明文化しているrepoは
# repo直下の agent-settings.env で ja-en にする
COMMIT_LANG_ORDER=en-ja

# --- レビュー担当と執筆担当のモデル（AGENTS.md §3・§7 / docs/policies/review.md） ---
# 値は「系統」または「系統(思考量)」を空白区切りで優先順に並べる。系統名は固定語彙では
# なく自由なラベルで、tool/modelの系統を指す（例: codex / fable / opus）。新モデルは
# その名前をここへ書くだけでよく、規則文書の改訂は不要。`any` は系統を問わない
# （履歴を共有しない別セッションであればよい）。値が空の場合は推測せず AGENTS.md §10 に
# 従って停止しユーザーへ確認する。
#
# これらのキーの値を変えてよいのは、ユーザーの明示指示があるときだけ（AGENTS.md §7）。
# 一時的に緩めるときも、痕跡が残るようgit管理下のenv（このファイルまたは作業repo直下の
# agent-settings.env）で行い、git管理外の agent-settings.local.env を使わない。
# 標準値の行をコメントアウトで残して暫定値の行と入れ替え、戻し忘れを防ぐ。

# 重リスク作業（AGENTS.md §7の重リスク区分）のレビュー担当
REVIEW_MODEL_HEAVY=codex(xhigh) fable

# 通常対象作業の実装レビュー担当
REVIEW_MODEL_DEFAULT=any

# 人間向け文書の読みやすさレビュー担当
REVIEW_MODEL_READABILITY=fable(low)

# 重リスク作業のレビュー担当に、実装担当と別系統のモデルを必須とする。
# trueのあいだ、同系統での代替は一時的なfallbackとしても認めない
REVIEW_REQUIRE_OTHER_LINEAGE=true

# 設計・仕組みの解説文書と、規則ファイル本文を書く担当（AGENTS.md §3）
WRITING_MODEL_DEEP=fable

# UI変更時の実画面確認の方式（AGENTS.md §5）。
#   full        = ブラウザ自動検証（Playwright等）まで必須（従来どおり）
#   screenshots = 自動検証は不要。主要なsize・state・themeのスクショを
#                 タスクの _ai/tasks/<開始日-slug>/screenshots/ へ撮りため、
#                 ユーザーの目視判断へ委ねる
#   off         = 実画面確認を全面免除。報告に未検証と明記する
# true / false は full / off の別名として扱う
UI_BROWSER_VERIFICATION=full

# --- 待ち時間の prompt cache 維持（CLAUDE.md。Claude Code固有） ---
# 再開・完了の見込み時刻が立つ待ちで、監視の張り直しを prompt cache の TTL より
# 短い間隔で行い、cache を保つことを許可する
CACHE_KEEPALIVE=true

# 連続で張り直す上限回数。超えたら張り直さず冷えるに任せる
CACHE_KEEPALIVE_MAX=3
